# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://ke:ke@localhost:5432/ke

# --- LLM ----------------------------------------------------------------
# Any OpenAI-compatible endpoint. LangChain's init_chat_model does the rest.
#
# Fully local on a 16 GB Mac (recommended starting point):
#   ollama pull qwen3.5:4b
#
# Hosted:
#   OpenRouter  https://openrouter.ai/api/v1   deepseek/deepseek-chat
#   OpenAI      https://api.openai.com/v1      gpt-5.2
#   Anthropic   https://api.anthropic.com/v1   claude-opus-5
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b

# How the model is held to a schema. `json_schema` (constrained decoding) is the
# default because small models flatten a nested schema when asked for it via
# `function_calling` — see ke/llm.py. Switch if your provider lacks it.
LLM_STRUCTURED_METHOD=json_schema
# Qwen3.5 thinks by default, and will burn its entire budget reasoning about an
# extraction instead of answering it. Empty = do not send the parameter at all
# (some providers reject it); low/medium/high if your model benefits from it.
LLM_REASONING_EFFORT=none
# A ceiling, so a runaway model fails fast instead of hanging a review.
LLM_MAX_TOKENS=2048

# --- Embeddings ---------------------------------------------------------
# local  = fastembed ONNX in-process (no extra service, no torch)
# remote = any OpenAI-compatible /embeddings endpoint (Ollama, OpenAI, ...)
EMBED_PROVIDER=local
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
# EMBED_PROVIDER=remote
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_DIM=1024

# --- Retrieval ----------------------------------------------------------
# Hybrid search fuses semantic (pgvector) and lexical (Postgres full-text)
# rankings with Reciprocal Rank Fusion. RRF_K dampens the top ranks; 60 is
# the value from the original RRF paper and a fine default.
RRF_K=60
RETRIEVE_TOP_K=10

# Conflict detection: how many neighbours to consider per new claim, and the
# cosine-distance cutoff past which a neighbour is not even a candidate.
# With the default embedding model, genuinely conflicting claims measure
# ~0.17-0.37 and unrelated ones ~0.85+. Retune if you change the model.
CONFLICT_TOP_K=5
CONFLICT_MAX_DISTANCE=0.55

# --- Audio (optional, needs the `audio` extra) --------------------------
WHISPER_MODEL=small

# --- Frontend -----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
REVIEW_BASE_URL=http://localhost:5173
