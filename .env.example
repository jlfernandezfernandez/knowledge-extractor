# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://ke:ke@localhost:5432/ke

# --- LLM (any OpenAI-compatible endpoint) -------------------------------
# Ollama:     http://localhost:11434/v1   (LLM_API_KEY can be anything)
# LM Studio:  http://localhost:1234/v1
# OpenRouter: https://openrouter.ai/api/v1
# Anthropic:  https://api.anthropic.com/v1   (model e.g. claude-opus-5)
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=changeme
LLM_MODEL=deepseek/deepseek-chat

# --- Embeddings ---------------------------------------------------------
# Default: local ONNX via fastembed, no extra service, CPU-only.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
# Optional: use a remote OpenAI-compatible /embeddings endpoint instead.
# EMBED_API_BASE=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=embeddinggemma
# EMBED_DIM=768

# --- Retrieval ----------------------------------------------------------
# How many neighbours to check per new claim, and the cosine-distance cutoff
# beyond which we stop treating a neighbour as related at all. With the default
# embedding model, genuinely conflicting claims measure ~0.17-0.37 and unrelated
# ones ~0.85+, so 0.55 sits comfortably between. Retune if you swap the model.
CONFLICT_TOP_K=5
CONFLICT_MAX_DISTANCE=0.55

# --- Audio (optional, needs the `audio` extra) --------------------------
WHISPER_MODEL=small
