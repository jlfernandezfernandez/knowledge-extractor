# Public web port. Docker publishes it on the host and its LAN interfaces;
# use a different value when 3000 is already occupied.
KNOWLI_PORT=3000

# Optional OpenAI-compatible model settings. The API still starts without them.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional speech support. Leave blank to keep speech engines disabled.
SPEECH_PROVIDER=
SPEECH_MODEL_DIR=
SPEECH_THREADS=4
WHISPER_MODEL=small
