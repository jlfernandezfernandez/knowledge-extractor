# Public local URL. Only the web service publishes this port.
KNOWLI_PORT=3000

# Optional OpenAI-compatible model settings. The API still starts without them.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional speech support. Leave blank to keep speech engines disabled.
SPEECH_PROVIDER=
SPEECH_MODEL_DIR=
SPEECH_THREADS=4
WHISPER_MODEL=small
