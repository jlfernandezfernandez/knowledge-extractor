# Public web port
KNOWLI_PORT=3000

# ==============================================================================
# LLM CONFIGURATION (Agent, Claim Extraction & Conflicts)
# ==============================================================================

# Option A: Local Ollama (Default)
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=ollama
MODEL_NAME=qwen3.5:9b

# Option B: OpenRouter
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_API_KEY=sk-or-v1-your-key-here
# MODEL_NAME=anthropic/claude-3.5-sonnet

# Option C: OpenAI direct
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=sk-proj-your-key-here
# MODEL_NAME=gpt-4o-mini

# Option D: Groq
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_API_KEY=gsk_your-key-here
# MODEL_NAME=llama-3.3-70b-versatile


# ==============================================================================
# AUDIO TRANSCRIPTION CONFIGURATION (OpenAI-compatible /audio/transcriptions)
# ==============================================================================

# Option A: Local Speaches / Faster-Whisper / Parakeet (Default)
TRANSCRIPTION_BASE_URL=http://host.docker.internal:8000/v1
TRANSCRIPTION_API_KEY=local
TRANSCRIPTION_MODEL=Systran/faster-whisper-base
# TRANSCRIPTION_MODEL=nvidia/parakeet-ctc-0.6b

# Option B: OpenAI Whisper direct
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_API_KEY=sk-proj-your-key-here
# TRANSCRIPTION_MODEL=whisper-1

# Option C: Groq / Cloud API Whisper or Parakeet
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_API_KEY=gsk_your-key-here
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
