# Public web port. Docker publishes it on the host and its LAN interfaces;
# use a different value when 3000 is already occupied.
KNOWLI_PORT=3000

# Text model. By default, Knowli uses Ollama running on this computer.
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=ollama
MODEL_NAME=qwen3.5:9b

# Microphone transcription uses any OpenAI-compatible `/audio/transcriptions`
# endpoint. This recommendation points from Docker to a local Speaches server.
TRANSCRIPTION_BASE_URL=http://host.docker.internal:8000/v1
TRANSCRIPTION_API_KEY=local
TRANSCRIPTION_MODEL=Systran/faster-whisper-small
